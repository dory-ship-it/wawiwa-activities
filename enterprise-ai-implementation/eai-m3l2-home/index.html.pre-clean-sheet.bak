<style>
:root{--ink:#33454E;--mut:#5C6E77;--teal:#5AB3AA;--tealtx:#2E6E76;--navy:#255777;--line:#CFE2E2;--bd:#8496A0}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:var(--ink);font:17px/1.55 Assistant,system-ui,-apple-system,Segoe UI,sans-serif}
.wrap{max-width:820px;margin:0 auto;padding:34px 22px 64px}
h1{font-size:34px;font-weight:700;line-height:1.2;margin:0 0 10px}
.lead{color:var(--mut);margin:0 0 6px}
.warn{background:#FDF6EC;border-left:4px solid #E17A1E;border-radius:10px;padding:13px 16px;margin:18px 0 26px;font-size:15.5px}
.stage{display:flex;align-items:center;gap:11px;margin:30px 0 14px}
.stage span{font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--tealtx)}
.stage i{flex:1;height:1px;background:var(--line)}
.card{position:relative;background:#fff;border-top:4px solid var(--teal);border-radius:16px;
 box-shadow:0 1px 2px rgba(37,87,119,.05),0 10px 26px rgba(37,87,119,.09);padding:26px 28px 24px;margin:0 0 20px}
.cn{font-size:12.5px;font-weight:700;color:var(--tealtx);letter-spacing:.06em;margin-bottom:4px}
.card h3{margin:0 0 8px;font-size:20px;font-weight:700}
.instr{margin:0 0 12px}
.aid{margin:0 0 12px;color:var(--mut);font-size:14.5px}
.chk{list-style:none;margin:0 0 14px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:5px 18px}
.chk.one{grid-template-columns:1fr;gap:7px}
.chk label{display:flex;gap:8px;align-items:flex-start;font-size:14.5px;cursor:pointer}
.chk input{margin-top:4px;accent-color:var(--navy)}
.yn{list-style:none;margin:0 0 14px;padding:0}
.yn li{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;padding:7px 0;border-bottom:1px solid var(--line)}
.yn li:last-child{border-bottom:0}
.ynq{flex:1 1 300px;font-size:15.5px}
.ynopts{display:flex;gap:14px}
.ynopts label{display:flex;gap:6px;align-items:center;font-size:14.5px;cursor:pointer;color:var(--mut)}
.ynopts input{accent-color:var(--navy)}
.fl{display:block;color:var(--mut);font-size:12.5px;font-weight:600;margin-bottom:5px}
textarea{width:100%;background:#fff;border:1px solid var(--bd);border-radius:10px;padding:12px 14px;
 font:16px/1.5 Assistant,sans-serif;color:var(--ink);resize:vertical}
textarea:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(37,87,119,.13)}
.row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:12px}
button.coach,button.path,button.pdf{background:var(--navy);color:#fff;border:0;border-radius:40px;
 padding:9px 18px;font:700 14px Assistant,sans-serif;cursor:pointer}
button.coach:hover,button.path:hover,button.pdf:hover{background:#1d4661}
button:disabled{opacity:.55;cursor:default}
.pii{color:var(--mut);font-size:13.75px}
